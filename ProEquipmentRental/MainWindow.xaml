<Window x:Class="ProEquipmentRental.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Аренда техники" Height="600" Width="900"
        Background="#FF1E1E1E" Icon="/photo_5233404817273721103_y.jpg">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 🔍 Верхняя панель -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Top">

            <!-- Поле поиска -->
            <Border Width="488" 
        Height="36"
        Background="#FF505050"
        CornerRadius="18">
                <TextBox x:Name="SearchBox" 
             BorderThickness="0"
             Padding="10,0,10,0"
             VerticalContentAlignment="Center"
             Foreground="White"
             FontSize="14" 
             Background="Transparent" Margin="0,0,10,0" />
            </Border>

            <!-- Кнопки -->
            <Button Content="Поиск" Width="100" Height="36"
                    Background="#FF9800" Foreground="White"
                    Click="Search_Click" Margin="0,0,10,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="18"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="Фильтр" Width="100" Height="36"
                    Background="#FF9800" Foreground="White"
                    Click="FilterButton_Click" Margin="0,0,10,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="18"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="Избранное" Width="120" Height="36"
                    Background="#FF9800" Foreground="White"
                    Click="Favorites_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="18"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>

        <!-- 📋 Список магазинов и сообщение -->
        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ShopList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12" BorderBrush="#FF505050" BorderThickness="1"
                                    Background="#FF505050" Margin="0,0,0,12" Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Верхняя часть карточки -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 🏪 Название, часы и рейтинг -->
                                        <StackPanel VerticalAlignment="Center" Grid.Column="0">
                                            <TextBlock Text="{Binding name}" 
                                                       FontSize="17" FontWeight="Bold"
                                                       Foreground="White" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding hours}" Foreground="White" FontSize="13"
                                                       Margin="0,0,0,2"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⭐" FontSize="14" Margin="0,0,2,0"/>
                                                <TextBlock Text="{Binding rating}" FontSize="13" Foreground="#FFFFD200"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- ❤️ и ▼ справа -->
                                        <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                                            <!-- ❤️ Кнопка избранное -->
                                            <Button x:Name="FavButton"
                                                    Content="❤️"
                                                    Width="30" Height="30"
                                                    Background="#FFB74D"
                                                    Foreground="White"
                                                    Margin="0,0,8,0"
                                                    Tag="{Binding id}"
                                                    Click="AddToFavorites_Click">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="15"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>

                                            <!-- 🔽 Кнопка "Подробнее" -->
                                            <Button Width="30" Height="30"
                                                    Background="#FF9800" Foreground="White"
                                                    Tag="{Binding RelativeSource={RelativeSource AncestorType=Border}}"
                                                    Click="ToggleDetails_Click"
                                                    x:Name="ArrowButton"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">
                                                <TextBlock Text="▼" FontSize="16" 
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center"/>
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="18"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 📖 Детали -->
                                    <Border x:Name="DetailsBorder" Grid.Row="1" Visibility="Collapsed" Height="0"
                                            Margin="0,10,0,0" Background="#FF1E1E1E" Padding="10" CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding description}" 
                                                       TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#FFFFFFFF"/>
                                            <TextBlock Text="{Binding address}" Foreground="#FFFFFFFF" Margin="0,0,0,8"/>
                                            <TextBlock>
                                                <Hyperlink NavigateUri="{Binding link}" RequestNavigate="Hyperlink_RequestNavigate">
                                                    <Run Text="{Binding link}"/>
                                                </Hyperlink>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 💬 Сообщение, если избранных нет -->
            <TextBlock x:Name="MessageText"
                       Text=""
                       Foreground="Gray"
                       FontSize="18"
                       FontStyle="Italic"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="20"/>
        </Grid>
    </Grid>
</Window>