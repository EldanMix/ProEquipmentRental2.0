<Window x:Class="ProEquipmentRental.FilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Фильтрация"
        Height="250" Width="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow" Background="#FF1E1E1E">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="Сортировать магазины:" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="White"/>

            <RadioButton x:Name="SortByNameAZ" Content="По названию (A–Z)" GroupName="Sort" FontSize="14" Margin="0,0,0,5" Foreground="White"/>
            <RadioButton x:Name="SortByNameZA" Content="По названию (Z–A)" GroupName="Sort" FontSize="14" Margin="0,0,0,5" Foreground="White"/>
            <RadioButton x:Name="SortByRatingHigh" Content="По рейтингу (от высокого к низкому)" GroupName="Sort" FontSize="14" Margin="0,0,0,5" Foreground="White"/>
            <RadioButton x:Name="SortByRatingLow" Content="По рейтингу (от низкого к высокому)" GroupName="Sort" FontSize="14" Margin="0,0,0,15" Foreground="White"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Применить" Width="100" Margin="5" Click="Apply_Click" Foreground="White" Background="#FF505050"/>
                <Button Content="Отмена" Width="100" Margin="5" Click="Cancel_Click" Background="#FF505050" Foreground="White"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>