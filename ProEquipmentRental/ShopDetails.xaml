<Window x:Class="ProEquipmentRental.ShopDetails"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Информация о магазине" Height="450" Width="650"
        Background="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock x:Name="ShopName" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock x:Name="ShopDescription" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,10"/>
            <TextBlock x:Name="ShopAddress" FontStyle="Italic" FontSize="14" Margin="0,0,0,10"/>
            <TextBlock x:Name="ShopRating" FontWeight="Bold" FontSize="14" Margin="0,0,0,20"/>
            <Button x:Name="OpenLink" Content="🌐 Перейти на сайт"
                    Width="180"
                    Height="35"
                    FontSize="14"
                    Background="#009933"
                    Foreground="White"
                    BorderThickness="0"
                    Click="OpenLink_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>